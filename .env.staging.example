# Copy to .env.staging.local (git-ignored) and fill in. Used only by npm run staging:build,
# npm run staging:start and the test scripts (node --env-file=.env.staging.local scripts/test-....mjs).
# Never put production values here: the staging scripts refuse to run if anything points at production.

STAGING_SUPABASE_REF=            # the staging project's reference id (20 characters)
STAGING_DB_URL=                  # staging Postgres connection string (session pooler), for applying migrations

NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=        # https://<staging ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=                     # any random value

AUTHORIZE_NET_API_LOGIN_ID=      # sandbox only
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_SIGNATURE_KEY=
AUTHORIZE_NET_ENV=sandbox

BASE_URL=http://localhost:3100
